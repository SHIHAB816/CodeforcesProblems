#include<stdio.h>
int main(){
    int a,i;
    long long  sum = 0;
    scanf("%d",&a);
    int arr[a];
    for(i=0;i<a;i++){
    scanf("%d",&arr[i]);
    sum=sum+arr[i];
    }
    
    if(sum<0){
    printf("%lld",sum*-1);
    }
    else if(sum>=0){
    printf("%lld",sum);
    }
    
    
     return 0;
     }
